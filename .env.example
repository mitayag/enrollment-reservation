# Copy to .env and fill in real values. NEVER commit .env.

# Secret used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# PostgreSQL container settings (the app's DATABASE_URL is derived from these
# by docker-compose.yml; set DATABASE_URL only if the app DB lives elsewhere).
POSTGRES_USER=enroll
POSTGRES_PASSWORD=enroll_password
POSTGRES_DB=enrolldb

# Session cookie security (set true behind HTTPS in production)
COOKIE_SECURE=false

# Application host/port for uvicorn (inside container)
APP_HOST=0.0.0.0
APP_PORT=8000
